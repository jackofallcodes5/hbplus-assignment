# ==========================================
# HB+ Secure Portal - Environment Variables
# ==========================================

# Target official domain restricted exclusively for login access
EXPO_PUBLIC_ALLOWED_DOMAIN=hbplus.fit

# Admin email list (comma-separated) for Role-Based Access Control (Admin vs User)
EXPO_PUBLIC_ADMIN_EMAILS=admin@hbplus.fit

# Google OAuth 2.0 Client IDs (from Google Cloud Console -> Credentials)
# Web Client ID (used for Web browser authentication)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your-google-web-client-id.apps.googleusercontent.com

# iOS Client ID (used when running on iOS device/simulator)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your-google-ios-client-id.apps.googleusercontent.com

# Android Client ID (used when running on Android device/emulator)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your-google-android-client-id.apps.googleusercontent.com

# Supabase Database Credentials (from https://supabase.com -> Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
